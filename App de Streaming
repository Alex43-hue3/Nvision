<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NETVISION - Streaming</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Outfit', sans-serif; background-color: #0b0f19; color: #f3f4f6; overflow-x: hidden; }
        .glass-card { background: rgba(17, 24, 39, 0.7); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.08); }
        .neon-glow { text-shadow: 0 0 20px rgba(0, 229, 255, 0.6); }
        /* Ocultar scrollbar pero permitir desplazamiento */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #0b0f19; }
        ::-webkit-scrollbar-thumb { background: #1f2937; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #374151; }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between relative">

    <!-- Fondo ambiental -->
    <div class="absolute inset-0 z-0 opacity-30 bg-cover bg-center pointer-events-none" style="background-image: url('https://images.unsplash.com/photo-1536440136628-849c177e76a1?q=80&w=1920&auto=format&fit=crop');"></div>
    <div class="absolute inset-0 z-0 bg-gradient-to-b from-[#0b0f19]/80 via-[#0b0f19]/90 to-[#0b0f19] pointer-events-none"></div>

    <!-- Header -->
    <header class="relative z-10 flex items-center justify-between px-6 py-4 border-b border-white/5 bg-[#0b0f19]/50 backdrop-blur-md">
        <div class="flex items-center space-x-3">
            <span class="text-2xl font-black tracking-wider text-white">NET<span class="text-[#00e5ff] neon-glow">VISION</span></span>
            <span class="text-xs text-gray-400 border-l border-gray-700 pl-3 hidden sm:inline">Hola, WED</span>
        </div>
        <div class="flex items-center space-x-4">
            <button onclick="changeView('home')" class="flex items-center space-x-2 text-sm text-gray-300 hover:text-white transition px-3 py-1.5 rounded-lg hover:bg-white/5">
                <i class="fa-solid fa-house"></i>
                <span class="hidden md:inline">Menú principal</span>
            </button>
            <button onclick="openSearchModal()" class="w-10 h-10 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center text-gray-300 transition">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>
            <div class="flex items-center space-x-2 bg-white/5 px-3 py-1.5 rounded-full border border-white/10">
                <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center text-white font-bold text-xs">W</div>
                <span class="text-sm font-medium text-gray-200">WED</span>
            </div>
        </div>
    </header>

    <!-- Contenido Principal -->
    <main class="relative z-10 flex-grow flex flex-col items-center justify-center px-4 py-10 max-w-7xl mx-auto w-full">
        
        <!-- VISTA: Menú Principal (Inspirado en tu captura) -->
        <div id="view-home" class="w-full text-center space-y-10 animate-fade-in">
            <div class="space-y-2">
                <span class="text-xs font-bold uppercase tracking-widest text-[#00e5ff]">Menú Principal</span>
                <h1 class="text-4xl md:text-5xl font-extrabold text-white">¿Qué quieres ver?</h1>
                <p class="text-gray-400 text-sm md:text-base">TV en vivo, películas y series en una sola experiencia.</p>
            </div>

            <!-- Tarjetas de Navegación -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto w-full">
                <!-- TV en vivo -->
                <div onclick="selectCategory('live')" class="glass-card p-6 rounded-2xl cursor-pointer hover:border-[#00e5ff]/50 transition group text-left relative overflow-hidden">
                    <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-blue-500/10 rounded-full blur-xl group-hover:bg-blue-500/25 transition"></div>
                    <div class="w-12 h-12 rounded-xl bg-blue-500/20 text-[#00e5ff] flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition">
                        <i class="fa-solid fa-tv"></i>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-1">TV EN VIVO</h3>
                    <p class="text-xs text-gray-400 mb-6">Canales en directo</p>
                    <div class="flex items-center text-xs font-semibold text-[#00e5ff] group-hover:translate-x-1 transition">
                        Explorar <i class="fa-solid fa-arrow-right ml-2"></i>
                    </div>
                </div>

                <!-- Películas -->
                <div onclick="selectCategory('movies')" class="glass-card p-6 rounded-2xl cursor-pointer hover:border-purple-500/50 transition group text-left relative overflow-hidden ring-1 ring-purple-500/30">
                    <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-purple-500/10 rounded-full blur-xl group-hover:bg-purple-500/25 transition"></div>
                    <div class="w-12 h-12 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition">
                        <i class="fa-solid fa-film"></i>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-1">PELÍCULAS</h3>
                    <p class="text-xs text-gray-400 mb-6">Explora nuestro catálogo</p>
                    <div class="flex items-center text-xs font-semibold text-purple-400 group-hover:translate-x-1 transition">
                        Explorar <i class="fa-solid fa-arrow-right ml-2"></i>
                    </div>
                </div>

                <!-- Series -->
                <div onclick="selectCategory('series')" class="glass-card p-6 rounded-2xl cursor-pointer hover:border-cyan-500/50 transition group text-left relative overflow-hidden">
                    <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-cyan-500/10 rounded-full blur-xl group-hover:bg-cyan-500/25 transition"></div>
                    <div class="w-12 h-12 rounded-xl bg-cyan-500/20 text-[#00e5ff] flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition">
                        <i class="fa-solid fa-clapperboard"></i>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-1">SERIES</h3>
                    <p class="text-xs text-gray-400 mb-6">Tus series favoritas</p>
                    <div class="flex items-center text-xs font-semibold text-[#00e5ff] group-hover:translate-x-1 transition">
                        Explorar <i class="fa-solid fa-arrow-right ml-2"></i>
                    </div>
                </div>
            </div>

            <!-- Botón Mi Lista -->
            <div>
                <button onclick="openWatchlist()" class="inline-flex items-center space-x-2 px-6 py-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white text-sm font-medium transition border border-white/10">
                    <i class="fa-solid fa-bookmark text-[#00e5ff]"></i>
                    <span>Mi lista</span>
                </button>
            </div>
        </div>

        <!-- VISTA: Catálogo / Contenido -->
        <div id="view-catalog" class="w-full hidden space-y-6">
            <div class="flex items-center justify-between border-b border-white/10 pb-4">
                <div class="flex items-center space-x-3">
                    <button onclick="changeView('home')" class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition">
                        <i class="fa-solid fa-arrow-left"></i>
                    </button>
                    <h2 id="catalog-title" class="text-2xl font-bold text-white uppercase">Catálogo</h2>
                </div>
                <!-- Filtros de Género -->
                <div id="genre-filters" class="flex items-center space-x-2 overflow-x-auto py-1">
                    <button onclick="filterGenre('all')" class="px-3 py-1 rounded-full bg-[#00e5ff] text-black font-semibold text-xs whitespace-nowrap">Todos</button>
                </div>
            </div>

            <!-- Cuadrícula de Contenido -->
            <div id="catalog-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                <!-- Se inyecta dinámicamente -->
            </div>
        </div>

    </main>

    <!-- Reproductor / Modal de Contenido -->
    <div id="player-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-xl hidden flex flex-col">
        <div class="flex items-center justify-between p-4 bg-black/60 border-b border-white/10">
            <h3 id="player-title" class="text-lg font-bold text-white truncate max-w-xl">Reproduciendo</h3>
            <button onclick="closePlayer()" class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>
        <div class="flex-grow flex flex-col md:flex-row overflow-hidden">
            <!-- Contenedor del video / iframe / reproductor -->
            <div class="flex-grow flex items-center justify-center bg-black relative p-4">
                <div id="video-container" class="w-full h-full max-h-[80vh] flex items-center justify-center">
                    <!-- Iframe o video nativo -->
                </div>
            </div>
            <!-- Panel lateral para Series (Temporadas y Episodios) -->
            <div id="series-episodes-panel" class="w-full md:w-80 bg-gray-900/90 border-l border-white/10 p-4 overflow-y-auto hidden flex flex-col space-y-4">
                <div class="flex space-x-2 border-b border-white/10 pb-3" id="seasons-tabs">
                    <!-- Pestañas de temporadas -->
                </div>
                <div id="episodes-list" class="space-y-2 flex-grow overflow-y-auto">
                    <!-- Lista de episodios -->
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="relative z-10 py-6 text-center text-xs text-gray-500 border-t border-white/5">
        <p>NETVISION Pro &copy; 2026. Todos los derechos reservados.</p>
    </footer>

    <script>
        // Datos sincronizados desde localStorage
        function getData(key) {
            try { return JSON.parse(localStorage.getItem('netvision_' + key)) || []; } catch(e) { return []; }
        }

        function getWatchlist() {
            try { return JSON.parse(localStorage.getItem('netvision_watchlist')) || []; } catch(e) { return []; }
        }

        function toggleWatchlist(id) {
            let list = getWatchlist();
            if (list.includes(id)) {
                list = list.filter(item => item !== id);
            } else {
                list.push(id);
            }
            localStorage.setItem('netvision_watchlist', JSON.stringify(list));
            alert('Lista actualizada');
        }

        let currentCategory = '';
        let currentItems = [];

        function changeView(view) {
            document.getElementById('view-home').classList.add('hidden');
            document.getElementById('view-catalog').classList.add('hidden');
            
            if (view === 'home') {
                document.getElementById('view-home').classList.remove('hidden');
            } else if (view === 'catalog') {
                document.getElementById('view-catalog').classList.remove('hidden');
            }
        }

        function selectCategory(category) {
            currentCategory = category;
            changeView('catalog');
            const titleEl = document.getElementById('catalog-title');
            
            if (category === 'live') {
                titleEl.innerText = 'TV en Vivo';
                currentItems = getData('channels');
            } else if (category === 'movies') {
                titleEl.innerText = 'Películas';
                currentItems = getData('movies');
            } else if (category === 'series') {
                titleEl.innerText = 'Series';
                currentItems = getData('series');
            }
            renderCatalog(currentItems);
        }

        function openWatchlist() {
            currentCategory = 'watchlist';
            changeView('catalog');
            document.getElementById('catalog-title').innerText = 'Mi Lista';
            
            const watchIds = getWatchlist();
            const movies = getData('movies');
            const series = getData('series');
            currentItems = [...movies, ...series].filter(item => watchIds.includes(item.id));
            renderCatalog(currentItems);
        }

        function renderCatalog(items) {
            const grid = document.getElementById('catalog-grid');
            grid.innerHTML = '';

            if (items.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-20 text-gray-500">No hay contenido disponible en esta sección. Añade contenido desde el panel de administración.</div>`;
                return;
            }

            items.forEach(item => {
                const card = document.createElement('div');
                card.className = 'glass-card rounded-xl overflow-hidden group cursor-pointer hover:scale-105 transition duration-300 flex flex-col';
                card.onclick = () => playItem(item);

                card.innerHTML = `
                    <div class="relative aspect-[2/3] bg-gray-800 overflow-hidden">
                        <img src="${item.poster || 'https://images.unsplash.com/photo-1485846234645-a62644f84728?q=80&w=500'}" alt="${item.title}" class="w-full h-full object-cover group-hover:scale-110 transition duration-500">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-3">
                            <span class="w-10 h-10 rounded-full bg-[#00e5ff] text-black flex items-center justify-center font-bold text-lg shadow-lg">
                                <i class="fa-solid fa-play ml-0.5"></i>
                            </span>
                        </div>
                    </div>
                    <div class="p-3 flex flex-col flex-grow justify-between">
                        <h4 class="font-bold text-sm text-white truncate">${item.title}</h4>
                        <span class="text-xs text-gray-400 mt-1">${item.genre || 'General'}</span>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function playItem(item) {
            const modal = document.getElementById('player-modal');
            const titleEl = document.getElementById('player-title');
            const container = document.getElementById('video-container');
            const seriesPanel = document.getElementById('series-episodes-panel');

            titleEl.innerText = item.title;
            modal.classList.remove('hidden');
            seriesPanel.classList.add('hidden');
            container.innerHTML = '';

            if (currentCategory === 'series' && item.seasons) {
                seriesPanel.classList.remove('hidden');
                renderSeasons(item.seasons);
                if (item.seasons.length > 0 && item.seasons[0].episodes.length > 0) {
                    playVideoUrl(item.seasons[0].episodes[0].url);
                }
            } else {
                playVideoUrl(item.url);
            }
        }

        function playVideoUrl(url) {
            const container = document.getElementById('video-container');
            if (!url) {
                container.innerHTML = `<div class="text-red-400 text-sm">Enlace de reproducción no disponible.</div>`;
                return;
            }

            if (url.includes('youtube.com') || url.includes('youtu.be')) {
                let videoId = '';
                if (url.includes('embed/')) {
                    videoId = url.split('embed/')[1].split('?')[0];
                } else if (url.includes('watch?v=')) {
                    videoId = url.split('watch?v=')[1].split('&')[0];
                } else {
                    videoId = url.split('/').pop();
                }
                container.innerHTML = `<iframe src="https://www.youtube.com/embed/${videoId}?autoplay=1" class="w-full h-full rounded-lg" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
            } else if (url.endsWith('.m3u8') || url.includes('m3u8')) {
                container.innerHTML = `<div class="text-center"><p class="text-yellow-400 mb-2 text-sm">Formato HLS (M3U8)</p><video controls autoplay class="w-full max-h-[70vh] rounded-lg"><source src="${url}" type="application/x-mpegURL">Tu navegador no soporta este formato de video.</video></div>`;
            } else {
                container.innerHTML = `<video src="${url}" controls autoplay class="w-full max-h-[70vh] rounded-lg"></video>`;
            }
        }

        function renderSeasons(seasons) {
            const tabsContainer = document.getElementById('seasons-tabs');
            const episodesContainer = document.getElementById('episodes-list');
            tabsContainer.innerHTML = '';
            episodesContainer.innerHTML = '';

            seasons.forEach((season, sIndex) => {
                const btn = document.createElement('button');
                btn.className = `px-3 py-1.5 rounded-lg text-xs font-bold transition ${sIndex === 0 ? 'bg-[#00e5ff] text-black' : 'bg-white/10 text-white hover:bg-white/20'}`;
                btn.innerText = `Temp ${season.seasonNumber || sIndex + 1}`;
                btn.onclick = () => {
                    document.querySelectorAll('#seasons-tabs button').forEach(b => b.className = 'px-3 py-1.5 rounded-lg text-xs font-bold bg-white/10 text-white hover:bg-white/20');
                    btn.className = 'px-3 py-1.5 rounded-lg text-xs font-bold bg-[#00e5ff] text-black';
                    renderEpisodes(season.episodes);
                };
                tabsContainer.appendChild(btn);
            });

            if (seasons.length > 0) {
                renderEpisodes(seasons[0].episodes);
            }
        }

        function renderEpisodes(episodes) {
            const container = document.getElementById('episodes-list');
            container.innerHTML = '';

            if (!episodes || episodes.length === 0) {
                container.innerHTML = `<p class="text-xs text-gray-500">No hay episodios en esta temporada.</p>`;
                return;
            }

            episodes.forEach((ep, idx) => {
                const card = document.createElement('div');
                card.className = 'p-2.5 rounded-lg bg-black/40 hover:bg-black/60 cursor-pointer flex items-center space-x-3 transition border border-white/5';
                card.onclick = () => playVideoUrl(ep.url);
                card.innerHTML = `
                    <div class="w-8 h-8 rounded-full bg-[#00e5ff]/20 text-[#00e5ff] flex items-center justify-center font-bold text-xs">${idx + 1}</div>
                    <div class="overflow-hidden">
                        <h5 class="text-xs font-bold text-white truncate">${ep.title || 'Episodio ' + (idx + 1)}</h5>
                        <p class="text-[10px] text-gray-400">Reproducir ahora</p>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function closePlayer() {
            document.getElementById('player-modal').classList.add('hidden');
            document.getElementById('video-container').innerHTML = '';
        }

        function openSearchModal() {
            const query = prompt('¿Qué película, serie o canal buscas?');
            if (!query) return;
            const movies = getData('movies');
            const series = getData('series');
            const channels = getData('channels');
            const results = [...movies, ...series, ...channels].filter(item => item.title.toLowerCase().includes(query.toLowerCase()));
            
            if (results.length > 0) {
                currentCategory = 'search';
                changeView('catalog');
                document.getElementById('catalog-title').innerText = `Resultados para: "${query}"`;
                renderCatalog(results);
            } else {
                alert('No se encontraron resultados.');
            }
        }

        // Sincronización en tiempo real entre pestañas/archivos
        window.addEventListener('storage', () => {
            // Recargar si estamos viendo algo que fue modificado
        });
    </script>
</body>
</html>
